# ── Runtime ─────────────────────────────────────
PORT=3456
NODE_ENV=development
# true 时不调用真实外部 AI/TTS/智能处理 API，便于演示和部署验证
MOCK_MODE=false
# 可选：临时文件目录；默认使用系统 tmp 目录
TMP_DIR=

# ── Agent Plan (统一 Chat + 图片 + 视频 + 搜索) ──
# 订阅地址: https://ai.volcengine.com/activity/agentplan
AGENT_PLAN_KEY=
AGENT_PLAN_BASE=https://ark.cn-beijing.volces.com/api/plan

# ── TTS 语音合成 ────────────────────────────────
TTS_API_KEY=
VOLCANO_TTS_APP_ID=
VOLCANO_TTS_CLUSTER=volcano_tts

# ── 智能处理 (ASR/抠图/增强) ────────────────────
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# ── FFmpeg 字体（可选）──────────────────────────
# Windows 示例: C:/Windows/Fonts/msyh.ttc
# macOS 示例: /System/Library/Fonts/PingFang.ttc
FFMPEG_FONT_FILE=
